#
# Camel-karaf specific: Apache Camel intentionally ships no service file for this
# language, because DefaultLanguageResolver resolves the name through a hardcoded
# branch instead. OsgiLanguageResolver has no such branch and looks the language up
# in the OSGi service registry, so without this entry "simple-no-file" cannot be
# resolved in Karaf and poll/pollEnrich with a simple expression fails with
# NoSuchLanguageException. Keep this file across Camel upgrades. See issue #707.
#
class=org.apache.camel.language.simple.SimpleNoFileLanguage
